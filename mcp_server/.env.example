# Copy to .env (next to this file) or export these in your shell / MCP client config.
CREDVAULT_URL=https://localhost:8904
# Either the token itself, or a file that contains it (keeps it out of client configs):
CREDVAULT_API_TOKEN=
# CREDVAULT_API_TOKEN_FILE=~/.config/credvault/token
# Trust the server's self-signed certificate (copy certs/server.crt from the server):
# CREDVAULT_CA_CERT=/path/to/server.crt
# Last resort only — disables certificate checks:
# CREDVAULT_VERIFY_TLS=0
