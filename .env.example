# Copy to .env and fill in. NEVER commit the real .env.

# First admin account (used only on first boot). Leave the password empty to have
# one generated into ./data/.admin_password. Minimum 10 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Long random string (>= 32 chars) used to sign sessions. Generate one with:
#   openssl rand -hex 32
# Leave empty to have one generated into ./data/.secret_key.
SECRET_KEY=

# Allow anyone who can reach the server to create an account (true/false).
ALLOW_REGISTRATION=true

# Lock an unlocked vault after this many idle minutes.
VAULT_IDLE_MINUTES=15

# Optional: serve the OpenAPI docs at /docs (off by default).
# ENABLE_API_DOCS=false

# Optional: comma-separated origins allowed to call the API cross-origin.
# CORS_ORIGINS=
